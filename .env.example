# LocalOSINT v3.0 Global Intelligence Command Centre Configuration
LOCALOSINT_HOST=127.0.0.1
LOCALOSINT_PORT=8000
LOCALOSINT_DATA_DIR=./data
LOCALOSINT_DB_PATH=./data/localosint.db

# Optional: Master Encryption Passphrase for Fernet Vault (auto-generated in data/.vault_key if unset)
# LOCALOSINT_SECRET_KEY=

# Local GraphRAG & LLM Integration (Ollama)
LOCALOSINT_OLLAMA_URL=http://127.0.0.1:11434
LOCALOSINT_OLLAMA_MODEL=llama3.1:8b

# Crucix Alert Notification Channels (Optional Webhooks)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=

# Passively Monitored Keyless Geospatial Feeds (Defaults: Live OpenSky, ADSB.lol, Digitraffic AIS, CelesTrak, USGS)
OFFLINE_MODE=false
